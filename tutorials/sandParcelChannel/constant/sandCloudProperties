FoamFile
{
 version 2.0; format ascii; class dictionary; object sandCloudProperties;
}
solution
{
 active true;
 coupled false;
 transient yes;
 cellValueSourceCorrection off;
 maxCo 0.3;
 interpolationSchemes { rho cell; U cellPoint; mu cell; }
 integrationSchemes { U analytical; }
 sourceTerms { schemes {} }
}
constantProperties { rho0 2650; }
subModels
{
 particleForces { sphereDrag; gravity; }
 injectionModels
 {
  feed
  {
   type sandTransectInjection;
   // kg/s across the entire strip (NOT kg/s per metre).
   massFeedRate 0.0001;
   parcelsPerSecond 1000;
   SOI 0;
   duration 1;
   d50 1.25e-4;
   patch upstream;
   // Origin is at the bed, centred across the strip, on the inlet plane.
   origin (0 0.05 0);
   widthDirection (0 1 0);
   width 0.04;
   depth 0.1;
   referenceHeight 0.005;
   maximumHeight 0.095;
   inwardOffset 1e-7;
   profile Rouse; // uniform = random uniform positions within this rectangle
   profileBins 256;
   shearVelocityModel localBed; // alternatively constant with uStar 0.02
   bedPatch bed;
   shearSampleLength 0.2;
   kappa 0.41;
   beta 1;
   fluxWeighted true;
   initialVelocity equilibrium; // carrier or carrier + terminal downward slip
   seed 12345;
   writeSamples false;
  }
 }
 dispersionModel none;
 patchInteractionModel localInteraction;
 localInteractionCoeffs
 {
  patches
  (
   bed { type stick; }
   "lid|sides" { type rebound; e 1; mu 0; }
   "upstream|downstream" { type escape; }
  );
 }
 surfaceFilmModel none;
 stochasticCollisionModel none;
}
cloudFunctions {}

// Optional fixed-bed re-entrainment; disabled preserves permanent sticking.
resuspension
{
 enabled false;
 bedPatches (bed); // These walls must use the stick interaction above.
 thresholdModel Shields; // Shields, shearStress, or nearBedVelocity
 criticalShields 0.05;
 // criticalShearStress 0.1; // Pa, for shearStress
 // criticalVelocity 0.2;   // m/s, for nearBedVelocity (bed owner cell)
 releaseRate 1;           // 1/s; lambda = rate * max(ratio - 1, 0)^exponent
 releaseExponent 1.5;
 minimumRestTime 0.1;     // s after deposition before release is permitted
 normalLaunchSpeed 0.02; // m/s into the water, along inward wall normal
 launchShearFactor 0;    // additional normal speed = factor * local uStar
 liftDiameters 2;        // inward displacement in particle diameters
 liftHeight 0;           // m; positive value overrides liftDiameters
 seed 67890;
 writeEvents false;
 initializeHistoryOnRestart false; // explicit opt-in when enabling on old results
}
