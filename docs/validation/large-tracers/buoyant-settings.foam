FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      largeTracerProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

count           25;

seed            42;

runName         tracers01;

diameter
{
    type            uniform;
    min             0.02;
    max             0.04;
}

density
{
    type            uniform;
    min             500;
    max             950;
}

seedRegion
{
    min             ( 1.2 0.1 -0.18 );
    max             ( 1.8 0.4 -0.03 );
    placement       volume;
    bedPatches      ( bed );
    minWaterFraction 0.99;
}

retentionMin    ( 1 0 -0.2 );

retentionMax    ( 2 0.5 0 );

rimElevation    0;

startTime       0;

endTime         3;

outputInterval  0.05;

maxDeltaT       0.002;

frozenFlow      false;

flowTime        0;

alphaField      alpha.water;

volumeSamples   128;

initialVelocity zero;

rhoWater        1000;

muWater         0.001;

rhoAir          1.2;

muAir           1.8e-05;

g               ( 0 0 -9.81 );

addedMassCoefficient 0.5;

restitution     0.1;

friction        0.4;

particleCollisions true;

mobilizationDiameters 1;
